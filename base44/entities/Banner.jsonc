{
  "name": "Banner",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "subtitle": {
      "type": "string",
      "title": "Subtitle"
    },
    "image": {
      "type": "string",
      "title": "Image URL"
    },
    "link": {
      "type": "string",
      "title": "Link"
    },
    "cta_text": {
      "type": "string",
      "title": "CTA Text"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "title": "Status",
      "default": "active"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}