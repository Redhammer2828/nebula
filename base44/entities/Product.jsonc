{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "short_description": {
      "type": "string",
      "title": "Short Description"
    },
    "price": {
      "type": "number",
      "title": "Price"
    },
    "sale_price": {
      "type": "number",
      "title": "Sale Price"
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "INR"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Image URLs"
    },
    "category_id": {
      "type": "string",
      "title": "Category ID"
    },
    "category_name": {
      "type": "string",
      "title": "Category Name"
    },
    "brand_id": {
      "type": "string",
      "title": "Brand ID"
    },
    "brand_name": {
      "type": "string",
      "title": "Brand Name"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Available Sizes"
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Available Colors"
    },
    "stock": {
      "type": "number",
      "title": "Stock Quantity",
      "default": 0
    },
    "sku": {
      "type": "string",
      "title": "SKU"
    },
    "specifications": {
      "type": "object",
      "title": "Specifications",
      "additionalProperties": true
    },
    "rating": {
      "type": "number",
      "title": "Average Rating",
      "default": 0
    },
    "reviews_count": {
      "type": "number",
      "title": "Reviews Count",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "title": "Featured",
      "default": false
    },
    "is_new": {
      "type": "boolean",
      "title": "New Arrival",
      "default": false
    },
    "is_best_seller": {
      "type": "boolean",
      "title": "Best Seller",
      "default": false
    },
    "is_sale": {
      "type": "boolean",
      "title": "On Sale",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "archived"
      ],
      "title": "Status",
      "default": "active"
    },
    "seo_title": {
      "type": "string",
      "title": "SEO Title"
    },
    "seo_description": {
      "type": "string",
      "title": "SEO Description"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "name",
    "slug",
    "price",
    "category_id"
  ]
}